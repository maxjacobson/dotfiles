#!/usr/bin/env fish

# Usage:
# $ paywall "https://cooking.nytimes.com/recipes/1893-everyday-pancakes"

if test (count $argv) -ne 1
    echo "Provide exactly one argument" >&2
    exit 1
end

function main --argument-names url
    set --local document_path (mktemp --directory)/document.html

    if curl --silent --show-error --location "$url" --output "$document_path"
        open "$document_path"
    else
        exit 1
    end
end

main $argv
